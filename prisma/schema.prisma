generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @db.Uuid
  email               String               @unique
  fullName            String?              @map("full_name")
  companyName         String?              @map("company_name")
  phone               String?
  dotNumber           String?              @map("dot_number")
  mcNumber            String?              @map("mc_number")
  stripeCustomerId    String?              @unique @map("stripe_customer_id")
  subscriptionPlan    SubscriptionPlan     @default(trial) @map("subscription_plan")
  truckCount          Int                  @default(1) @map("truck_count")
  inboxEmail          String               @unique @map("inbox_email")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  brokers             Broker[]
  complianceDocuments ComplianceDocument[]
  detentionRecords    DetentionRecord[]
  documents           Document[]
  drivers             Driver[]
  emailLogs           EmailLog[]
  iftaRecords         IftaRecord[]
  invoices            Invoice[]
  loads               Load[]
  notifications       Notification[]
  subscriptions       Subscription[]
  trucks              Truck[]

  @@map("users")
}

model Truck {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  truckNumber  String       @map("truck_number")
  vin          String?
  make         String?
  model        String?
  year         Int?
  licensePlate String?      @map("license_plate")
  status       TruckStatus  @default(active)
  createdAt    DateTime     @default(now()) @map("created_at")
  drivers      Driver[]
  iftaRecords  IftaRecord[]
  loads        Load[]
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, truckNumber])
  @@index([userId])
  @@map("trucks")
}

model Driver {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  fullName        String       @map("full_name")
  phone           String?
  email           String?
  licenseNumber   String?      @map("license_number")
  licenseExpiry   DateTime?    @map("license_expiry") @db.Date
  assignedTruckId String?      @map("assigned_truck_id") @db.Uuid
  status          DriverStatus @default(active)
  createdAt       DateTime     @default(now()) @map("created_at")
  assignedTruck   Truck?       @relation(fields: [assignedTruckId], references: [id])
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  loads           Load[]

  @@index([userId])
  @@map("drivers")
}

model Broker {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  companyName      String    @map("company_name")
  contactName      String?   @map("contact_name")
  email            String?
  phone            String?
  mcNumber         String?   @map("mc_number")
  paymentTermsDays Int       @default(30) @map("payment_terms_days")
  factoringCompany String?   @map("factoring_company")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices         Invoice[]
  loads            Load[]

  @@index([userId])
  @@map("brokers")
}

model Load {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  loadNumber         String            @map("load_number")
  brokerId           String?           @map("broker_id") @db.Uuid
  truckId            String?           @map("truck_id") @db.Uuid
  driverId           String?           @map("driver_id") @db.Uuid
  shipperName        String?           @map("shipper_name")
  shipperAddress     String?           @map("shipper_address")
  consigneeName      String?           @map("consignee_name")
  consigneeAddress   String?           @map("consignee_address")
  pickupDate         DateTime?         @map("pickup_date")
  deliveryDate       DateTime?         @map("delivery_date")
  actualDeliveryDate DateTime?         @map("actual_delivery_date")
  commodity          String?
  weightLbs          Int?              @map("weight_lbs")
  palletCount        Int?              @map("pallet_count")
  rateAmount         Decimal           @default(0) @map("rate_amount") @db.Decimal(10, 2)
  fuelSurcharge      Decimal           @default(0) @map("fuel_surcharge") @db.Decimal(10, 2)
  detentionAmount    Decimal           @default(0) @map("detention_amount") @db.Decimal(10, 2)
  lumperAmount       Decimal           @default(0) @map("lumper_amount") @db.Decimal(10, 2)
  totalInvoiceAmount Decimal           @default(0) @map("total_invoice_amount") @db.Decimal(10, 2)
  status             LoadStatus        @default(pending)
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  detentionRecords   DetentionRecord[]
  documents          Document[]
  invoices           Invoice[]
  broker             Broker?           @relation(fields: [brokerId], references: [id])
  driver             Driver?           @relation(fields: [driverId], references: [id])
  truck              Truck?            @relation(fields: [truckId], references: [id])
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, loadNumber])
  @@index([userId, status])
  @@index([userId, pickupDate])
  @@map("loads")
}

model Document {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  loadId            String?      @map("load_id") @db.Uuid
  documentType      DocumentType @default(other) @map("document_type")
  fileUrl           String       @map("file_url")
  fileName          String       @map("file_name")
  fileSize          Int          @map("file_size")
  mimeType          String       @map("mime_type")
  aiExtractedData   Json?        @map("ai_extracted_data")
  aiConfidenceScore Float?       @map("ai_confidence_score")
  manuallyVerified  Boolean      @default(false) @map("manually_verified")
  uploadedVia       UploadSource @default(manual_upload) @map("uploaded_via")
  createdAt         DateTime     @default(now()) @map("created_at")
  load              Load?        @relation(fields: [loadId], references: [id])
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType])
  @@index([loadId])
  @@map("documents")
}

model Invoice {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  loadId             String         @map("load_id") @db.Uuid
  invoiceNumber      String         @map("invoice_number")
  invoiceDate        DateTime       @default(now()) @map("invoice_date") @db.Date
  dueDate            DateTime       @map("due_date") @db.Date
  billToBrokerId     String?        @map("bill_to_broker_id") @db.Uuid
  subtotal           Decimal        @default(0) @db.Decimal(10, 2)
  detentionCharges   Decimal        @default(0) @map("detention_charges") @db.Decimal(10, 2)
  lumperCharges      Decimal        @default(0) @map("lumper_charges") @db.Decimal(10, 2)
  fuelSurcharge      Decimal        @default(0) @map("fuel_surcharge") @db.Decimal(10, 2)
  totalAmount        Decimal        @default(0) @map("total_amount") @db.Decimal(10, 2)
  status             InvoiceStatus  @default(draft)
  pdfUrl             String?        @map("pdf_url")
  sentAt             DateTime?      @map("sent_at")
  paidAt             DateTime?      @map("paid_at")
  paymentMethod      PaymentMethod? @map("payment_method")
  factoringCompany   String?        @map("factoring_company")
  reminderCount      Int            @default(0) @map("reminder_count")
  lastReminderSentAt DateTime?      @map("last_reminder_sent_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  broker             Broker?        @relation(fields: [billToBrokerId], references: [id])
  load               Load           @relation(fields: [loadId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, invoiceNumber])
  @@index([userId, status])
  @@map("invoices")
}

model DetentionRecord {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  loadId              String          @map("load_id") @db.Uuid
  startTime           DateTime        @map("start_time")
  endTime             DateTime?       @map("end_time")
  freeHours           Int             @default(2) @map("free_hours")
  hourlyRate          Decimal         @default(50) @map("hourly_rate") @db.Decimal(10, 2)
  totalHours          Decimal?        @map("total_hours") @db.Decimal(6, 2)
  totalCharge         Decimal         @default(0) @map("total_charge") @db.Decimal(10, 2)
  reason              String?
  evidenceDocumentIds String[]        @map("evidence_document_ids") @db.Uuid
  status              DetentionStatus @default(active)
  createdAt           DateTime        @default(now()) @map("created_at")
  load                Load            @relation(fields: [loadId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("detention_records")
}

model ComplianceDocument {
  id                 String                 @id @default(uuid()) @db.Uuid
  userId             String                 @map("user_id") @db.Uuid
  documentType       ComplianceDocumentType @map("document_type")
  title              String
  fileUrl            String                 @map("file_url")
  issueDate          DateTime?              @map("issue_date") @db.Date
  expiryDate         DateTime?              @map("expiry_date") @db.Date
  reminderDaysBefore Int                    @default(30) @map("reminder_days_before")
  status             ComplianceStatus       @default(valid)
  createdAt          DateTime               @default(now()) @map("created_at")
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiryDate])
  @@map("compliance_documents")
}

model EmailLog {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  direction        EmailDirection
  fromEmail        String         @map("from_email")
  toEmail          String         @map("to_email")
  subject          String?
  bodyPreview      String?        @map("body_preview")
  relatedLoadId    String?        @map("related_load_id") @db.Uuid
  relatedInvoiceId String?        @map("related_invoice_id") @db.Uuid
  attachmentsCount Int            @default(0) @map("attachments_count")
  processed        Boolean        @default(false)
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_logs")
}

model IftaRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  truckId   String   @map("truck_id") @db.Uuid
  quarter   Int
  year      Int
  stateCode String   @map("state_code") @db.Char(2)
  miles     Decimal  @default(0) @db.Decimal(10, 2)
  gallons   Decimal  @default(0) @db.Decimal(10, 3)
  taxOwed   Decimal  @default(0) @map("tax_owed") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  truck     Truck    @relation(fields: [truckId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([truckId, year, quarter, stateCode])
  @@index([userId, year, quarter])
  @@map("ifta_records")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  message   String
  type      NotificationType @default(info)
  read      Boolean          @default(false)
  actionUrl String?          @map("action_url")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  plan                 SubscriptionPlan
  truckCount           Int                @map("truck_count")
  monthlyAmount        Decimal            @map("monthly_amount") @db.Decimal(10, 2)
  status               SubscriptionStatus
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

enum SubscriptionPlan {
  trial
  lite
  pro
  enterprise
}

enum TruckStatus {
  active
  inactive
  maintenance
}

enum DriverStatus {
  active
  inactive
}

enum LoadStatus {
  pending
  in_transit
  delivered
  invoiced
  paid
  overdue
}

enum DocumentType {
  rate_confirmation
  bill_of_lading
  proof_of_delivery
  lumper_receipt
  fuel_receipt
  insurance_certificate
  w9
  mc_authority
  driver_license
  other
}

enum UploadSource {
  email
  manual_upload
  api
}

enum InvoiceStatus {
  draft
  sent
  submitted_to_factor
  paid
  overdue
  disputed
}

enum PaymentMethod {
  check
  ach
  factoring
  other
}

enum DetentionStatus {
  active
  completed
  invoiced
  paid
}

enum ComplianceDocumentType {
  insurance
  w9
  mc_authority
  dot_authority
  driver_license
  medical_card
  other
}

enum ComplianceStatus {
  valid
  expiring_soon
  expired
}

enum EmailDirection {
  inbound
  outbound
}

enum NotificationType {
  info
  warning
  error
  success
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}
