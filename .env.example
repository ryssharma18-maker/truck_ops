# ---------------------------------------------------------------- database
# Supabase → Project Settings → Database → Connection string
# DATABASE_URL uses the transaction pooler (port 6543) for runtime queries.
# DIRECT_URL uses the session pooler (port 5432) for migrations, which need a
# non-transactional connection for advisory locks.
# connect_timeout=30 is not optional on a slow or proxied network: Prisma's
# 5s default is not enough for a cold TLS handshake through some ISPs, and the
# symptom is a P1001 "Can't reach database server" on an otherwise healthy host.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connect_timeout=30"

# ---------------------------------------------------------------- supabase
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Bypasses RLS. Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------- app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Domain that per-tenant inbound addresses live under, e.g.
# fleet-<id>@inbox.truckops.ai
INBOUND_EMAIL_DOMAIN="inbox.truckops.ai"

# ------------------------------------------------------------------- seeding
# Which account `npm run db:seed` populates. Defaults to demo@truckops.ai.
# Point it at an account that already has a Supabase login to seed it without
# a service_role key:
#   SEED_EMAIL="you@example.com"
# SEED_EMAIL=""
# Only used when the seed has to create the login, which needs the real
# service_role key.
# SEED_PASSWORD=""

# There is no demo mode. Authentication always requires a real Supabase
# session; a missing URL or anon key fails closed with 500 rather than
# inventing a user.

# ------------------------------------------------- ai (google ai studio)
# Key name must be exactly GEMINI_API_KEY — lib/services/aiService.ts reads it.
GEMINI_API_KEY=""

# ---------------------------------------------------------- transactional email
# Resend (preferred) and SendGrid are both supported; set at least one. Until
# one is set, the invoices page hides its send buttons and POST
# /api/invoices/[id]/send returns 503 rather than pretending to send.
RESEND_API_KEY=""
SENDGRID_API_KEY=""
# Optional: the From address on outbound mail. Must be a domain you verify with
# the provider, or SPF/DMARC will reject it. Falls back to the verified
# Resend/SendGrid sender.
OUTBOUND_FROM_EMAIL=""
OUTBOUND_FROM_NAME="TruckOps AI"

# -------------------------------------------------------------- inbound email
# Shared secret the provider signs inbound webhooks with. The endpoint fails
# closed with 503 when unset. Generate with: openssl rand -base64 32
RESEND_INBOUND_WEBHOOK_SECRET=""
SENDGRID_INBOUND_WEBHOOK_SECRET=""

# ------------------------------------------------------------------ billing
# Test keys are fine locally; the webhook secret comes from `stripe listen`.
# The webhook refuses to process events without a real secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring price IDs from the Stripe dashboard, one per plan. Test-mode and
# live-mode price IDs differ, so these are never hardcoded.
STRIPE_PRICE_LITE=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
