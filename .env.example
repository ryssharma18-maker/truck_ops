# ---------------------------------------------------------------- database
# Supabase → Project Settings → Database → Connection string
# DATABASE_URL uses the pooler (port 6543) for serverless runtime queries.
# DIRECT_URL uses the direct connection (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------- supabase
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Bypasses RLS. Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------- app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Domain that per-tenant inbound addresses live under, e.g.
# fleet-<id>@inbox.truckops.ai
INBOUND_EMAIL_DOMAIN="inbox.truckops.ai"
# There is no demo mode. Authentication always requires a real Supabase
# session; a missing URL or anon key fails closed with 500 rather than
# inventing a user.

# ------------------------------------------------- ai (google ai studio)
# Key name must be exactly GEMINI_API_KEY — lib/services/aiService.ts reads it.
GEMINI_API_KEY=""

# ---------------------------------------------------------- transactional email
# Resend (preferred) and SendGrid are both supported; set at least one.
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# -------------------------------------------------------------- inbound email
# Shared secret the provider signs inbound webhooks with. The endpoint fails
# closed with 503 when unset. Generate with: openssl rand -base64 32
RESEND_INBOUND_WEBHOOK_SECRET=""
SENDGRID_INBOUND_WEBHOOK_SECRET=""

# ------------------------------------------------------------------ billing
# Test keys are fine locally; the webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
